# 本文件仅为模板，所有值都是占位符，不含任何真实凭据。
# 复制为 .env 后请自行填写；.env 已被 .gitignore 忽略，切勿提交。

# Cloudflare API Token（用于 wrangler deploy）
# 获取方式：https://dash.cloudflare.com/profile/api-tokens
# 权限要求：Workers Scripts - Edit
CLOUDFLARE_API_TOKEN=your_token_here

# ------------------------------------------------------------------
# 以下为 Worker 运行时可选变量，建议用 `wrangler secret put` 配置，
# 不要写入本文件。仅当你需要 TURN 中继时才配置：
#   TURN_SECRET=your_coturn_static_auth_secret
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# ------------------------------------------------------------------
